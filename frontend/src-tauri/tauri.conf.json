{
    "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName": "TriNote",
    "version": "1.0.0",
    "identifier": "com.trinhhuutho.trinote",
    "build": {
        "frontendDist": "../out",
        "devUrl": "http://localhost:3118",
        "beforeDevCommand": "pnpm dev",
        "beforeBuildCommand": "pnpm build"
    },
    "app": {
        "windows": [
            {
                "title": "TriNote",
                "width": 1100,
                "height": 700,
                "resizable": true,
                "fullscreen": false,
                "theme": "Light",
                "decorations": true
            }
        ],
        "macOSPrivateApi": true,
        "security": {
            "csp": {
                "default-src": "'self'",
                "style-src": "'self' 'unsafe-inline'",
                "img-src": "'self' asset: https://asset.localhost data:",
                "connect-src": "'self' http://localhost:11434 https://api.ollama.ai"
            },
            "assetProtocol": {
                "enable": true,
                "scope": [
                    "$APPDATA/**"
                ]
            },
            "capabilities": [
                {
                    "identifier": "main",
                    "description": "Main window capability",
                    "windows": [
                        "main"
                    ],
                    "permissions": [
                        "core:path:default",
                        "core:event:default",
                        "core:window:default",
                        "core:app:default",
                        "core:resources:default",
                        "core:menu:default",
                        "core:tray:default",
                        "core:window:allow-set-title",
                        "store:default",
                        "notification:default",
                        "notification:allow-is-permission-granted"
                    ]
                }
            ]
        }
    },
    "bundle": {
        "active": true,
        "publisher": "Trinh Huu Tho",
        "homepage": "https://github.com/TrinhHuuTho/trinote",
        "copyright": "Copyright (c) 2024 Zackriya Solutions, (c) 2026 Trinh Huu Tho",
        "license": "MIT",
        "category": "Productivity",
        "shortDescription": "Private meeting notes for English, Vietnamese and Chinese",
        "longDescription": "Record, transcribe and summarize meetings on your own computer. TriNote transcribes mixed English, Vietnamese and Chinese meetings live, summarizes them with a local or cloud model of your choice, and exports notes as PDF. No account, no analytics.",
        "targets": [
            "deb",
            "appimage",
            "msi",
            "nsis",
            "app",
            "dmg"
        ],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.png",
            "icons/app_icon.icns",
            "icons/app_icon.ico"
        ],
        "resources": [
            "templates/*.json"
        ],
        "externalBin": [
            "binaries/trinote-llama-helper",
            "binaries/trinote-ffmpeg"
        ],
        "macOS": {
            "entitlements": "entitlements.plist",
            "signingIdentity": "-",
            "hardenedRuntime": true
        },
        "windows": {
            "signCommand": "powershell -ExecutionPolicy Bypass -File scripts/sign-windows.ps1 -FilePath %1"
        },
        "linux": {
            "deb": {
                "depends": [
                    "libvulkan1",
                    "libasound2",
                    "libssl3"
                ],
                "recommends": [
                    "pipewire-bin"
                ],
                "section": "sound"
            }
        }
    }
}
